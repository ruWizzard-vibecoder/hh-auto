# PostgreSQL
POSTGRES_PASSWORD=changeme

# hh.ru credentials (browser login via Playwright)
HH_EMAIL=
HH_PASSWORD=

# hh.ru API OAuth (client_credentials flow)
# Register an app at https://dev.hh.ru — required since April 2026
# (anonymous /vacancies returns 403 forbidden everywhere)
HH_AUTO_HH_CLIENT_ID=
HH_AUTO_HH_CLIENT_SECRET=

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# Routed via SOCKS5 ssh-proxy:10808 — Gemini API blocked from RU IPs
GEMINI_API_KEY=

# OpenRouter API key (legacy fallback — inactive while ai_provider=gemini)
OPENROUTER_API_KEY=

# Telegram notifications (bot token + target chat)
# Routed via SOCKS5 ssh-proxy:10808 — Telegram API blocked from RU IPs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
